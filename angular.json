{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "legion-team-tandil-web": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/legion-team-tandil-web",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "assets": [ { "glob": "**/*", "input": "src/assets", "output": "assets" } ],
            "styles": ["src/styles.css"]
          },
          "configurations": {
            "production": { "optimization": true, "outputHashing": "all", "budgets": [ { "type": "initial", "maximumWarning": "650kB", "maximumError": "1MB" } ] },
            "development": { "optimization": false, "sourceMap": true }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": { "buildTarget": "legion-team-tandil-web:build:production" },
            "development": { "buildTarget": "legion-team-tandil-web:build:development" }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  },
  "cli": {
    "analytics": "1880d5af-0f06-4eb6-b821-96ddcb8466f4"
  }
}
